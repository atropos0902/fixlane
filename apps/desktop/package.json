{
  "name": "@fixlane/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Security tickets to pull requests, worked by coding agents",
  "license": "Apache-2.0",
  "type": "module",
  "main": "dist/electron/main.cjs",
  "scripts": {
    "build": "node build.ts",
    "start": "electron .",
    "e2e": "playwright test",
    "dist": "pnpm build && electron-builder --publish never"
  },
  "build": {
    "appId": "dev.fixlane.desktop",
    "productName": "fixlane",
    "executableName": "fixlane",
    "files": [
      "dist/electron",
      "dist/ui"
    ],
    "directories": {
      "output": "release"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Development"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.developer-tools"
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "npmRebuild": false
  },
  "devDependencies": {
    "@fixlane/core": "workspace:*",
    "@fixlane/daemon": "workspace:*",
    "@fixlane/fakes": "workspace:*",
    "@playwright/test": "1.59.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/ws": "8.18.1",
    "@vitejs/plugin-react": "6.0.1",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "electron": "41.5.0",
    "electron-builder": "26.9.0",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "vite": "8.0.10",
    "ws": "8.20.0",
    "zod": "4.4.3"
  }
}
